/*
 * Board overlay for the nRF52 DK (nRF52832).
 *
 * IMU pin range: P0.00-P0.08 and P0.25-P0.31, single SPI bus.
 *
 * P0.00/P0.01 are the 32.768 kHz crystal (XL1/XL2) on the DK, P0.02 is AREF,
 * P0.03/P0.04/P0.05/P0.07 are the MAX98357A I2S + SD_MODE pins, and P0.06/
 * P0.08 are the UART console.  There is therefore no usable 4.5 kHz signal
 * pin left in P0.00-P0.08.  All seven IMU signals are placed in P0.25-P0.31:
 *
 *   P0.31 = SCK    (SPI1 default)
 *   P0.30 = MOSI   (SPI1 default)
 *   P0.29 = MISO   (SPI1 default)
 *   P0.28 = CS1
 *   P0.27 = CS2    (I2C0 SCL on the DK, I2C0 is disabled below)
 *   P0.26 = INT1   (I2C0 SDA on the DK; use suitable level translation)
 *   P0.25 = INT2
 *
 * The DK push buttons P0.13-P0.16 have debouncing capacitors and are not used
 * for the 4.5 kHz data-ready edges.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	max98357a: max98357a {
		compatible = "maxim,max98357a";
		status = "okay";
		i2s-controller = <&i2s0>;
		sdin-gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
		sample-rate = <8000>;
		word-size = <16>;
		preload-blocks = <3>;
	};
};

/* ------------------------------------------------------------------------- */
/* UART console / MCUboot serial recovery.                                    */
/* Board silk (CH340 side): TXD -> P0.06, RXD <- P0.08.  The MCU therefore    */
/* transmits on P0.08 and receives on P0.06.  Do not use the nRF52 DK default */
/* P0.06=TX / P0.08=RX assignment on this board.  P0.05/P0.07 stay free for   */
/* the MAX98357A.                                                             */
/* ------------------------------------------------------------------------- */
&uart0 {
	/delete-property/ hw-flow-control;
};

&uart0_default {
	group1 {
		psels = <NRF_PSEL(UART_TX, 0, 8)>,
			<NRF_PSEL(UART_RX, 0, 6)>;
	};
};

&uart0_sleep {
	group1 {
		psels = <NRF_PSEL(UART_RX, 0, 6)>;
	};
	group2 {
		psels = <NRF_PSEL(UART_TX, 0, 8)>;
	};
};

/* ------------------------------------------------------------------------- */
/* P0.26/P0.27 are used by the IMU, so disable I2C0.                          */
/* P0.25/P0.23/P0.24 belong to SPI2's Arduino pin configuration; disable it. */
/* ------------------------------------------------------------------------- */
&i2c0 {
	status = "disabled";
};

&spi2 {
	status = "disabled";
};

/* ------------------------------------------------------------------------- */
/* SPI1: one bus, two chip selects, 1 MHz for bring-up, EasyDMA.             */
/* P0.31 = SCK, P0.30 = MOSI, P0.29 = MISO (board default SPI1 pins).         */
/* P0.28 = CS1, P0.27 = CS2.                                                  */
/* GY-ICM20948V2 CS/SDO/INT are 1.8 V signals: see README section 4.2.        */
/* ------------------------------------------------------------------------- */
&spi1 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	cs-gpios = <&gpio0 28 GPIO_ACTIVE_LOW>,
		   <&gpio0 27 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";

	icm20948_0: icm20948@0 {
		compatible = "invensense,icm20948";
		reg = <0>;
		/* Single-device test: keep CS0 inactive, only access IMU1. */
		status = "disabled";
		spi-max-frequency = <1000000>;
		int-gpios = <&gpio0 26 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		accel-range-g = <8>;
		gyro-range-dps = <500>;
		accel-dlpf-bypass;
		gyro-dlpf-cfg = <7>;
		gyro-sample-rate-div = <0>;
	};

	icm20948_1: icm20948@1 {
		compatible = "invensense,icm20948";
		reg = <1>;
		status = "okay";
		spi-max-frequency = <1000000>;
		int-gpios = <&gpio0 25 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		accel-range-g = <8>;
		gyro-range-dps = <500>;
		accel-dlpf-bypass;
		gyro-dlpf-cfg = <7>;
		gyro-sample-rate-div = <0>;
	};
};

/* ------------------------------------------------------------------------- */
/* I2S0: MAX98357A does not need MCLK.                                        */
/* P0.05 = BCLK, P0.04 = LRCLK, P0.03 = DIN                                  */
/* ------------------------------------------------------------------------- */
&pinctrl {
	i2s0_default: i2s0_default {
		group1 {
			psels = <NRF_PSEL(I2S_SCK_M, 0, 5)>,
				<NRF_PSEL(I2S_LRCK_M, 0, 4)>,
				<NRF_PSEL(I2S_SDOUT, 0, 3)>;
		};
	};

	i2s0_sleep: i2s0_sleep {
		group1 {
			psels = <NRF_PSEL(I2S_SCK_M, 0, 5)>,
				<NRF_PSEL(I2S_LRCK_M, 0, 4)>,
				<NRF_PSEL(I2S_SDOUT, 0, 3)>;
			low-power-enable;
		};
	};
};

&i2s0 {
	status = "okay";
	clock-source = "PCLK32M_HFXO";
	pinctrl-0 = <&i2s0_default>;
	pinctrl-1 = <&i2s0_sleep>;
	pinctrl-names = "default", "sleep";
};
