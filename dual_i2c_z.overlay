&spi0 { status = "disabled"; };
&spi1 { status = "disabled"; };
&icm20948_0 { status = "disabled"; };
&icm20948_1 { status = "disabled"; };
&max98357a { status = "disabled"; };
&i2s0 { status = "disabled"; };
&pinctrl {
	dual0_default: dual0_default {
		group1 { psels = <NRF_PSEL(TWIM_SCL, 0, 29)>, <NRF_PSEL(TWIM_SDA, 0, 28)>; };
	};
	dual0_sleep: dual0_sleep {
		group1 { psels = <NRF_PSEL(TWIM_SCL, 0, 29)>, <NRF_PSEL(TWIM_SDA, 0, 28)>; low-power-enable; };
	};
	dual1_default: dual1_default {
		group1 { psels = <NRF_PSEL(TWIM_SCL, 0, 31)>, <NRF_PSEL(TWIM_SDA, 0, 30)>; };
	};
	dual1_sleep: dual1_sleep {
		group1 { psels = <NRF_PSEL(TWIM_SCL, 0, 31)>, <NRF_PSEL(TWIM_SDA, 0, 30)>; low-power-enable; };
	};
};
&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-0 = <&dual0_default>;
	pinctrl-1 = <&dual0_sleep>;
	pinctrl-names = "default", "sleep";
};
&i2c1 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-0 = <&dual1_default>;
	pinctrl-1 = <&dual1_sleep>;
	pinctrl-names = "default", "sleep";
};
